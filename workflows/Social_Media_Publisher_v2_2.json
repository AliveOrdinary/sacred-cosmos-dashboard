    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst platforms = Array.isArray(body.platforms) && body.platforms.length ? body.platforms : ['instagram', 'facebook'];\n\n// v2.2: reels carry a video_url instead of image_urls\nif (body.post_type === 'reel') {\n  if (!body.video_url) {\n    throw new Error('post_type is reel but no video_url in payload.');\n  }\n  return [{\n    json: {\n      caption: body.caption || '',\n      video_url: body.video_url,\n      image_urls: [],\n      image_count: 0,\n      post_type: 'reel',\n      platforms,\n      do_instagram: platforms.includes('instagram'),\n      do_facebook: platforms.includes('facebook'),\n    },\n  }];\n}\n\nconst imageUrls = Array.isArray(body.image_urls) ? body.image_urls : [];\nconst postType = body.post_type === 'story' ? 'story' : 'feed';\nif (imageUrls.length === 0) {\n  throw new Error('No image_urls in payload \\u2014 nothing to publish.');\n}\nreturn [{\n  json: {\n    caption: body.caption || '',\n    image_urls: imageUrls,\n    image_count: imageUrls.length,\n    post_type: postType,\n    platforms,\n    do_instagram: platforms.includes('instagram'),\n    do_facebook: platforms.includes('facebook'),\n  },\n}];"
      },
