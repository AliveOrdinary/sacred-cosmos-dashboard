      "parameters": {
        "jsCode": "// Video containers genuinely need status polling (unlike images).\nconst s = $json.status_code || '';\nif (s === 'ERROR' || s === 'EXPIRED') {\n  throw new Error('IG reel container failed: ' + JSON.stringify($json.status || s));\n}\nif ($runIndex > 40) {\n  throw new Error('IG reel still processing after ~8 minutes \\u2014 giving up.');\n}\nreturn [{ json: { ready: s === 'FINISHED' } }];"
