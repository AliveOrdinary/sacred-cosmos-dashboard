{
  "name": "Reel Auto-Render (6:20 AM)",
  "nodes": [
    {
      "id": "ffe8343e-adc1-4531-aabe-381dacd63ec0",
      "name": "Schedule 6:20 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 6,
              "triggerAtMinute": 20
            }
          ]
        }
      },
      "notes": "Runs 20 minutes after the daily generator so reel_scripts exist."
    },
    {
      "id": "a69f5b29-7798-4bc1-aef8-e3554204106d",
      "name": "Render Manifestation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        0,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://sacred-reels:3123/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ composition: \"manifestation\" }) }}",
        "options": {
          "timeout": 8000
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Fire-and-forget: returns 202 immediately, renders in the background.\nNo payload lookup needed here \u2014 the render server fetches the newest cosmic_data row itself, and if reel_scripts is missing it errors out BEFORE any ElevenLabs call and records status=error in reel_renders. Duplicating that check in this workflow only added bugs."
    },
    {
      "id": "b18b140f-1b3c-467f-8396-187cffc9cc81",
      "name": "Wait 8 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        240,
        0
      ],
      "webhookId": "4cc52dbb-3251-46de-9d5b-16c850aee1b5",
      "parameters": {
        "amount": 8,
        "unit": "minutes"
      },
      "notes": "Stagger so the two renders do not compete for CPU on the homelab."
    },
    {
      "id": "0d402bdb-2a34-433c-9157-2c5229077284",
      "name": "Render Elements",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://sacred-reels:3123/render",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ composition: \"elements\" }) }}",
        "options": {
          "timeout": 8000
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Fire-and-forget: returns 202 immediately, renders in the background.\nNo payload lookup needed here \u2014 the render server fetches the newest cosmic_data row itself, and if reel_scripts is missing it errors out BEFORE any ElevenLabs call and records status=error in reel_renders. Duplicating that check in this workflow only added bugs."
    }
  ],
  "connections": {
    "Schedule 6:20 AM": {
      "main": [
        [
          {
            "node": "Render Manifestation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Render Manifestation": {
      "main": [
        [
          {
            "node": "Wait 8 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 8 min": {
      "main": [
        [
          {
            "node": "Render Elements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}